# VALORANT Tracker Core

# Optional official Riot API key used for account-name lookup fallback.
RIOT_API_KEY=

# Local Flask server and short-lived player profile cache.
BACKEND_PORT=5000
PLAYER_CACHE_TTL=60

# Set false to skip the heavier per-player enrichment on the live board.
LIVE_INCLUDE_STATS=true

# Maximum outbound Riot requests per second.
RIOT_MAX_RPS=10

# Suppress routine local-client diagnostics when true.
TRACKER_QUIET=false

# Development only.
FLASK_DEBUG=false
